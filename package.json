{
  "name": "hax-psu",
  "description": "HAX.psu homepage",
  "license": "Apache-2.0",
  "author": "btopro",
  "version": "26.11.0",
  "type": "module",
  "scripts": {
    "screenshots": "node scripts/screenshot.mjs",
    "build:agent-skills": "node scripts/build-agent-skills-index.cjs",
    "sync:content": "node scripts/sync-static-content.mjs",
    "check:content": "node scripts/sync-static-content.mjs --check",
    "build": "npm run screenshots && npm run sync:content && npm run build:bundle && npm run build:agent-skills && npm run build:package",
    "build:ci": "npm run build:bundle && npm run build:package",
    "build:bundle": "rimraf dist && rollup -c rollup.config.js && npm run analyze -- --exclude dist built",
    "build:package": "rm -rf built && cp -r dist built && cp -r env/* built/ && cp env/.htaccess built/ && cp llms.txt llms-full.txt built/ && cp -r .well-known built/",
    "start:build": "web-dev-server --root-dir dist --app-index index.html --open",
    "analyze": "cem analyze --litelement",
    "start": "web-dev-server"
  },
  "dependencies": {
    "@haxtheweb/d-d-d": "^26.11.0",
    "@haxtheweb/future-terminal-text": "^26.11.0",
    "@haxtheweb/hax-iconset": "^26.11.0",
    "@haxtheweb/hax-marketing-theme": "^26.11.0",
    "@haxtheweb/hax-network-bar": "^26.11.0",
    "@haxtheweb/rpg-character": "^26.11.0",
    "@haxtheweb/simple-icon": "^26.11.0",
    "@haxtheweb/un-sdg": "^26.11.0",
    "@haxtheweb/video-player": "^26.11.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.5",
    "@custom-elements-manifest/analyzer": "0.4.17",
    "@open-wc/building-rollup": "^3.0.0",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@web/dev-server": "0.4.6",
    "@web/rollup-plugin-html": "1.10.1",
    "@web/rollup-plugin-import-meta-assets": "1.0.7",
    "babel-plugin-template-html-minifier": "4.1.0",
    "deepmerge": "4.2.2",
    "playwright": "^1.62.1",
    "rimraf": "3.0.2",
    "rollup": "^3.30.0",
    "rollup-plugin-copy": "3.4.0",
    "rollup-plugin-workbox": "9.0.0",
    "sharp": "^0.35.3"
  },
  "customElements": "custom-elements.json",
  "overrides": {
    "serialize-javascript": "7.1.0",
    "rollup-plugin-workbox": "9.0.0"
  }
}
