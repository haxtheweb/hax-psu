# Protect files and directories from prying eyes.
<FilesMatch "\.(make|test|po|sh|.*sql|theme|tpl(\.php)?|xtmpl)(~|\.sw[op]|\.bak|\.orig|\.save)?$|^(\.(?!well-known).*|Entries.*|Repository|Root|Tag|Template|composer\.(json|lock))$|^#.*#$|\.php(~|\.sw[op]|\.bak|\.orig\.save)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
  </IfModule>
</FilesMatch>
# Don't show directory listings for URLs which map to a directory.
Options -Indexes
# Follow symbolic links in this directory.
Options +FollowSymLinks
# Set the default handler.
DirectoryIndex index.php index.html
# Override PHP settings that cannot be changed at runtime. See
<IfModule mod_php5.c>
  php_flag magic_quotes_gpc                 off
  php_flag magic_quotes_sybase              off
  php_flag register_globals                 off
  php_flag session.auto_start               off
  php_value mbstring.http_input             pass
  php_value mbstring.http_output            pass
  php_flag mbstring.encoding_translation    off
</IfModule>
# fix for wasm
<IfModule mod_mime.c>
  # llms.txt / llms-full.txt are UTF-8 Markdown; without a charset some
  # clients mangle punctuation, and .md should not download as a binary.
  AddCharset utf-8 .txt .md
  AddType text/markdown .md
  RemoveType .gz
  AddEncoding gzip .gz
  # The correct MIME type for .data.gz would be application/octet-stream, but due to Safari bug https://bugs.webkit.org/show_bug.cgi?id=247421, it is preferable to use MIME Type application/gzip instead.
  #AddType application/octet-stream .data.gz
  AddType application/wasm .wasm

  AddType application/gzip .data.gz
  AddType application/wasm .wasm.gz
  AddType application/javascript .js.gz
  AddType application/octet-stream .symbols.json.gz

  RemoveType .br
  AddEncoding br .br
  AddType application/octet-stream .data.br
  AddType application/wasm .wasm.br
  AddType application/javascript .js.br
  AddType application/octet-stream .symbols.json.br
</IfModule>
# Cache policy is set explicitly via Cache-Control headers below (mod_headers).
# The previous ExpiresDefault A1209600 catch-all was removed because it
# cascaded into the /cdn/ subtree and competed with the CDN's own policy.
# Cache-Control supersedes Expires per HTTP/1.1, so the explicit rules
# below are authoritative for the homepage and leave /cdn/ untouched.
# Various rewrite rules.
<IfModule mod_rewrite.c>
  RewriteEngine on
  # Set "protossl" to "s" if we were accessed via https://.  This is used later
  # if you enable "www." stripping or enforcement, in order to ensure that
  # you don't bounce between http and https.
  RewriteRule ^ - [E=protossl]
  RewriteCond %{HTTPS} on
  RewriteRule ^ - [E=protossl:s]
  # Make sure Authorization HTTP header is available to PHP
  # even when running as CGI or FastCGI.
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # Markdown content negotiation: agents that ask for the homepage with
  # "Accept: text/markdown" (and not text/html) get the Markdown twin of the
  # page instead of the JS app shell. Browsers always send text/html.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{HTTP:Accept} !text/html [NC]
  RewriteRule ^(index\.(html|php))?$ llms-full.txt [L,E=markdown_request:1]
  # Pass all requests not referring directly to files in the filesystem to
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ . [L]

  # Rules to correctly serve gzip compressed CSS and JS files.
  # Requires both mod_rewrite and mod_headers to be enabled.
  <IfModule mod_headers.c>
    # Serve gzip compressed CSS files if they exist and the client accepts gzip.
    RewriteCond %{HTTP:Accept-encoding} gzip
    RewriteCond %{REQUEST_FILENAME}\.gz -s
    RewriteRule ^(.*)\.css $1\.css\.gz [QSA]
    # Serve gzip compressed JS files if they exist and the client accepts gzip.
    RewriteCond %{HTTP:Accept-encoding} gzip
    RewriteCond %{REQUEST_FILENAME}\.gz -s
    RewriteRule ^(.*)\.js $1\.js\.gz [QSA]
    # Serve correct content types, and prevent mod_deflate double gzip.
    RewriteRule \.css\.gz$ - [T=text/css,E=no-gzip:1]
    RewriteRule \.js\.gz$ - [T=text/javascript,E=no-gzip:1]
    <FilesMatch "(\.js\.gz|\.css\.gz)$">
      # Serve correct encoding type.
      Header set Content-Encoding gzip
      # Force proxies to cache gzipped & non-gzipped css/js files separately.
      Header append Vary Accept-Encoding
    </FilesMatch>
  </IfModule>
</IfModule>
# Mark requests targeting the shared CDN subtree (/cdn/1.x.x) so the
# homepage cache policy below skips them — the CDN has its own policy.
# (A docroot .htaccess cascades into subdirs, so without this guard the
# FilesMatch rules would also hit /cdn/ assets.)
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI ^/cdn/ cdn_asset
  SetEnvIf Request_URI ^/(index\.(html|php))?$ homepage_request
</IfModule>
# Add headers to all responses.
<IfModule mod_headers.c>
  # Disable content sniffing, since it's an attack vector.
  Header always set X-Content-Type-Options nosniff
  # The homepage varies by Accept (HTML app vs Markdown, see rewrite above);
  # tell caches so they don't hand Markdown to a browser.
  Header merge Vary Accept env=homepage_request
  Header set Content-Type "text/markdown; charset=utf-8" env=REDIRECT_markdown_request
  Header set Content-Type "text/markdown; charset=utf-8" env=markdown_request
  # Long, immutable cache for content-hashed rollup assets (entry/chunks
  # are emitted as [hash].js / [hash].css — safe to cache for a year).
  # env=!cdn_asset keeps these OFF the /cdn/ subtree.
  <FilesMatch "^([a-f0-9]{6,})\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable" env=!cdn_asset
  </FilesMatch>
  # Long cache for static media/font assets shipped with the homepage.
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|eot)$">
    Header always set Cache-Control "public, max-age=31536000" env=!cdn_asset
  </FilesMatch>
  # Service worker and HTML must always revalidate so updates ship quickly.
  <FilesMatch "^(sw\.js|index\.html?)$">
    Header always set Cache-Control "no-cache, must-revalidate" env=!cdn_asset
  </FilesMatch>
  # PHP endpoints are dynamic — never cache (the CDN serves no PHP).
  <FilesMatch "\.php$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
